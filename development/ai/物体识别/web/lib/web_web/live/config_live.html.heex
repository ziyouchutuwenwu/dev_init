<Layouts.app flash={@flash}>
  <div class="w-full min-h-screen px-4 sm:px-6 lg:px-8 py-5 bg-zinc-100">
    <header class="mb-4 bg-white rounded-xl border border-zinc-200 shadow-sm p-3.5 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <div class="w-2.5 h-2.5 rounded-full bg-blue-600 animate-pulse"></div>
        <h1 class="text-base sm:text-lg font-bold text-zinc-800 tracking-tight">视觉检测系统</h1>
      </div>

      <nav
        id="live-session-nav"
        class="flex items-center gap-1.5 bg-zinc-100 p-1 rounded-lg border border-zinc-200 text-xs"
      >
        <.link
          navigate={~p"/"}
          id="nav-monitor"
          class="px-3.5 py-1.5 rounded-md font-semibold text-zinc-600 hover:text-zinc-900 hover:bg-white/80 transition-all"
        >
          监控
        </.link>
        <.link
          navigate={~p"/config"}
          id="nav-config"
          class="px-3.5 py-1.5 rounded-md font-bold text-white bg-zinc-800 shadow-xs transition-all"
        >
          配置
        </.link>
      </nav>
    </header>

    <.form for={%{}} as={:config} phx-change="validate" phx-submit="save_global" id="config-form">
      <div id="config-view-container">
        <div
          id="gateway-callback-config-panel"
          class="mb-5 bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden"
        >
          <div class="px-5 py-3.5 bg-zinc-50 border-b border-zinc-200">
            <h2 class="text-sm sm:text-base font-bold text-zinc-800">系统服务配置</h2>
          </div>

          <div class="p-5 space-y-4 text-xs">
            <div class="flex items-center gap-2">
              <label class="text-zinc-600 font-bold whitespace-nowrap">网关地址:</label>
              <input
                type="text"
                name="gateway_url"
                id="server-base-url"
                value={@gateway_url}
                class="w-full max-w-md rounded-md border border-zinc-300 px-3 py-1.5 text-xs font-mono text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
              />
            </div>

            <div class="flex flex-wrap items-center gap-6">
              <div class="flex items-center gap-2">
                <label class="text-zinc-600 font-bold whitespace-nowrap">回调地址:</label>
                <input
                  type="text"
                  name="alert_callback_url"
                  id="alert-callback-url"
                  value={@alert_callback_url}
                  class="w-72 sm:w-80 rounded-md border border-zinc-300 px-3 py-1.5 text-xs font-mono text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                />
              </div>

              <div class="flex items-center gap-2">
                <label class="text-zinc-600 font-bold whitespace-nowrap">最少间隔时间 (秒):</label>
                <input
                  type="number"
                  min="0"
                  name="alert_cooldown_sec"
                  id="alert-cooldown-sec"
                  value={@alert_cooldown_sec}
                  class="w-24 rounded-md border border-zinc-300 px-3 py-1.5 text-xs font-mono text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                />
              </div>

              <div class="flex items-center gap-2">
                <label class="text-zinc-600 font-bold whitespace-nowrap">请求超时 (秒):</label>
                <input
                  type="number"
                  min="1"
                  name="alert_timeout_sec"
                  id="alert-timeout-sec"
                  value={@alert_timeout_sec}
                  class="w-24 rounded-md border border-zinc-300 px-3 py-1.5 text-xs font-mono text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                />
              </div>
            </div>
          </div>
        </div>

        <div
          id="stream-config-panel"
          class="mb-5 bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden"
        >
          <div class="px-5 py-3 bg-zinc-50 border-b border-zinc-200 flex items-center justify-between">
            <h2 class="text-sm sm:text-base font-bold text-zinc-800">通道配置</h2>
            <button
              type="button"
              phx-click="add_stream"
              id="btn-add-stream-row"
              class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 text-xs font-semibold transition-all cursor-pointer shadow-xs active:scale-[0.98]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
              </svg>
              添加
            </button>
          </div>

          <div class="p-5">
            <div class="overflow-x-auto rounded-lg border border-zinc-200">
              <table class="w-full text-left text-xs text-zinc-700 border-collapse">
                <thead>
                  <tr class="border-b border-zinc-200 text-zinc-600 bg-zinc-50 font-bold">
                    <th class="py-2.5 px-3 w-36">流标识</th>
                    <th class="py-2.5 px-3">RTSP 视频流地址</th>
                    <th class="py-2.5 px-3 w-56">检测类型</th>
                    <th class="py-2.5 px-3 w-24 text-center">启用</th>
                    <th class="py-2.5 px-3 w-32 text-center">检测种类</th>
                    <th class="py-2.5 px-3 w-20 text-center">操作</th>
                  </tr>
                </thead>
                <tbody id="stream-rows-container" class="divide-y divide-zinc-100">
                  <%= for {stream, idx} <- Enum.with_index(@config_streams) do %>
                    <% is_current = idx == @current_stream_idx %>
                    <tr class={"stream-row transition-colors " <> if(is_current, do: "bg-blue-50/50 ring-1 ring-inset ring-blue-300", else: "hover:bg-zinc-50")}>
                      <td class="py-3 px-3 w-36">
                        <input
                          type="text"
                          name={"streams[#{idx}][stream_id]"}
                          class="input-stream-id w-28 sm:w-32 rounded-md border border-zinc-300 px-2.5 py-1.5 font-mono text-xs text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                          value={stream.stream_id}
                        />
                      </td>
                      <td class="py-3 px-3">
                        <input
                          type="text"
                          name={"streams[#{idx}][rtsp_url]"}
                          class="input-stream-url w-full rounded-md border border-zinc-300 px-3 py-1.5 font-mono text-xs text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                          value={stream.rtsp_url}
                        />
                      </td>
                      <td class="py-3 px-3 w-56">
                        <select
                          name={"streams[#{idx}][model]"}
                          class="w-full rounded-md border border-zinc-300 px-2.5 py-1.5 text-xs font-semibold text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 cursor-pointer"
                        >
                          <%= for m <- @all_models do %>
                            <option value={m.id} selected={stream.model == m.id}>
                              {m.name}
                            </option>
                          <% end %>
                        </select>
                      </td>
                      <td class="py-3 px-3 text-center">
                        <input type="hidden" name={"streams[#{idx}][enabled]"} value="false" />
                        <label class="inline-flex items-center cursor-pointer">
                          <input
                            type="checkbox"
                            name={"streams[#{idx}][enabled]"}
                            value="true"
                            checked={stream.enabled}
                            class="sr-only peer"
                          />
                          <div class="relative w-9 h-5 bg-zinc-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600"></div>
                        </label>
                      </td>
                      <td class="py-3 px-3 text-center">
                        <button
                          type="button"
                          phx-click="select_stream_to_config"
                          phx-value-index={idx}
                          class={"inline-flex items-center gap-1 px-2.5 py-1 rounded text-xs font-semibold transition-all cursor-pointer " <>
                            if(is_current,
                              do: "bg-blue-600 text-white shadow-xs",
                              else: "bg-zinc-100 text-zinc-700 hover:bg-blue-50 hover:text-blue-700 border border-zinc-200"
                            )}
                        >
                          <span>{if is_current, do: "正在配置", else: "配置类别"}</span>
                          <span class={"text-[10px] px-1 rounded " <> if(is_current, do: "bg-blue-700", else: "bg-zinc-200")}>
                            {length(stream.selected_classes || [])}项
                          </span>
                        </button>
                      </td>
                      <td class="py-3 px-3 text-center">
                        <button
                          type="button"
                          phx-click="remove_stream"
                          phx-value-index={idx}
                          class="btn-remove-row rounded border border-red-200 bg-red-50 text-red-600 hover:bg-red-100 hover:border-red-300 px-2.5 py-1 text-xs font-semibold cursor-pointer transition-colors shadow-2xs flex items-center justify-center gap-1 mx-auto"
                          title="删除此路直播流通道"
                        >
                          删除
                        </button>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <% current_stream = Enum.at(@config_streams, @current_stream_idx) %>
        <% current_model_meta = Web.ModelLoader.get_model(@active_model) %>
        <div
          id="industrial-classes-panel"
          class="mb-5 bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden"
        >
          <div class="px-5 py-3.5 bg-zinc-50 border-b border-zinc-200 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2.5 flex-wrap">
              <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
              <h2 class="text-sm sm:text-base font-bold text-zinc-800">
                通道 <span class="text-blue-700 font-mono">{current_stream.stream_id}</span>
              </h2>
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                <span>{current_model_meta.name}</span>
              </span>
            </div>

            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded bg-zinc-200/70 text-zinc-700">
                已选 {length(@selected_classes)} / {length(@all_classes)} 项
              </span>
              <button
                type="button"
                phx-click="select_all_classes"
                class="inline-flex items-center rounded-md bg-blue-50 border border-blue-200 px-2.5 py-1 text-xs font-semibold text-blue-700 hover:bg-blue-100 transition-colors cursor-pointer"
              >
                全选
              </button>
              <button
                type="button"
                phx-click="clear_all_classes"
                class="inline-flex items-center rounded-md bg-zinc-100 border border-zinc-300 px-2.5 py-1 text-xs font-semibold text-zinc-600 hover:bg-zinc-200 transition-colors cursor-pointer"
              >
                清空
              </button>
            </div>
          </div>

          <div class="px-5 py-2 bg-blue-50/60 border-b border-blue-100 text-xs text-blue-900 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="font-bold">模型说明:</span>
              <span>{current_model_meta.desc}</span>
            </div>
            <span class="text-[11px] text-blue-600 font-mono hidden md:inline">垂直模型仅检测所列目标，告警规则已针对该模型自动匹配</span>
          </div>

          <div class="px-5 pt-3.5 pb-2.5 bg-white border-b border-zinc-100 flex flex-wrap items-center justify-between gap-3">
            <div class="relative flex-1 min-w-[240px] max-w-md">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-zinc-400">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <input
                type="text"
                name="class_search"
                id="class-search-input"
                value={@class_search}
                phx-change="search_classes"
                phx-keyup="search_classes"
                phx-debounce="100"
                placeholder="搜索当前模型的检测类别..."
                autocomplete="off"
                class="w-full pl-9 pr-8 py-1.5 text-xs text-zinc-800 placeholder-zinc-400 bg-zinc-50 border border-zinc-300 rounded-lg focus:outline-none focus:bg-white focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors"
              />
              <%= if @class_search != "" do %>
                <button
                  type="button"
                  phx-click="clear_search"
                  title="清空搜索"
                  class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-zinc-400 hover:text-zinc-600 cursor-pointer"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                  </svg>
                </button>
              <% end %>
            </div>

            <%= if @class_search != "" do %>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-700 bg-zinc-100 px-2.5 py-1 rounded-md border border-zinc-200">
                  找到 <span class="font-bold font-mono text-zinc-900">{MapSet.size(@matched_class_ids)}</span> 项
                </span>
                <button
                  type="button"
                  phx-click="clear_search"
                  class="text-xs text-zinc-500 hover:text-zinc-700 underline cursor-pointer"
                >
                  清除
                </button>
              </div>
            <% end %>
          </div>

          <div class="p-5">
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-4 xl:grid-cols-5 gap-2.5">
              <%= for cls <- @all_classes do %>
                <%
                  is_matched = MapSet.member?(@matched_class_ids, cls.id)
                  is_selected = cls.id in @selected_classes
                  is_searching = @class_search != ""
                %>
                <button
                  type="button"
                  phx-click="toggle_class"
                  phx-value-id={cls.id}
                  class={"group relative flex items-center justify-between p-2.5 rounded-lg border text-left transition-all cursor-pointer " <>
                    cond do
                      is_searching and is_matched and is_selected ->
                        "bg-amber-50/95 border-amber-500 text-amber-950 ring-2 ring-amber-400 shadow-md scale-[1.01]"

                      is_searching and is_matched ->
                        "bg-amber-50/90 border-amber-400 text-amber-900 ring-2 ring-amber-300 shadow-sm scale-[1.01]"

                      is_searching and not is_matched ->
                        "bg-zinc-50/30 border-zinc-200 text-zinc-400 opacity-40 hover:opacity-80"

                      is_selected ->
                        "bg-blue-50/80 border-blue-400 text-blue-900 shadow-xs ring-1 ring-blue-300/70"

                      true ->
                        "bg-zinc-50/50 border-zinc-200 text-zinc-600 hover:bg-zinc-100/70 hover:border-zinc-300"
                    end}
                >
                  <div class="flex items-center gap-2 min-w-0">
                    <div class={"w-4 h-4 rounded flex items-center justify-center border transition-colors flex-shrink-0 " <>
                      if(is_selected,
                        do: "bg-blue-600 border-blue-600 text-white",
                        else: "bg-white border-zinc-300 group-hover:border-zinc-400"
                      )}>
                      <%= if is_selected do %>
                        <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                      <% end %>
                    </div>
                    <div class="flex flex-col min-w-0">
                      <span class={"text-xs truncate leading-tight " <> if(is_searching and is_matched, do: "font-bold text-amber-950", else: "font-semibold")}>
                        {cls.name}
                      </span>
                      <span class={"text-[10px] font-mono truncate leading-tight " <> if(is_searching and is_matched, do: "text-amber-700 font-medium", else: "text-zinc-400")}>
                        {cls.code}
                      </span>
                    </div>
                  </div>
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <div class="pt-2 flex items-center justify-end">
          <button
            type="submit"
            id="btn-global-save"
            class="rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2.5 text-xs sm:text-sm font-bold transition-all cursor-pointer shadow-sm hover:shadow active:scale-[0.99]"
          >
            保存
          </button>
        </div>
      </div>
    </.form>
  </div>
</Layouts.app>
