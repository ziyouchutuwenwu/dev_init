<div class="w-full min-h-screen px-4 sm:px-6 lg:px-8 py-5 bg-zinc-100">
  <header class="mb-4 bg-white rounded-xl border border-zinc-200 shadow-sm p-3.5 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2.5">
      <div class="w-2.5 h-2.5 rounded-full bg-blue-600 animate-pulse"></div>
      <h1 class="text-base sm:text-lg font-bold text-zinc-800 tracking-tight">视觉检测</h1>
    </div>

    <nav class="flex items-center gap-1.5 bg-zinc-100 p-1 rounded-lg border border-zinc-200 text-xs">
      <.link
        patch={~p"/"}
        class={
          if @live_action == :home,
            do:
              "px-3.5 py-1.5 rounded-md font-bold text-white bg-zinc-800 shadow-xs transition-all",
            else:
              "px-3.5 py-1.5 rounded-md font-semibold text-zinc-600 hover:text-zinc-900 hover:bg-white/80 transition-all"
        }
      >
        监控
      </.link>
      <.link
        patch={~p"/config"}
        class={
          if @live_action == :config,
            do:
              "px-3.5 py-1.5 rounded-md font-bold text-white bg-zinc-800 shadow-xs transition-all",
            else:
              "px-3.5 py-1.5 rounded-md font-semibold text-zinc-600 hover:text-zinc-900 hover:bg-white/80 transition-all"
        }
      >
        配置
      </.link>
    </nav>
  </header>

  <div
    id="global-feedback-toast"
    class="hidden fixed top-6 left-1/2 -translate-x-1/2 z-50 px-5 py-2.5 rounded-xl shadow-lg border text-xs font-semibold tracking-wide transition-all pointer-events-none"
  >
  </div>

  <div
    id="stream-config-feedback"
    class="hidden fixed top-6 left-1/2 -translate-x-1/2 z-50 px-5 py-2.5 rounded-xl shadow-lg border text-xs font-semibold tracking-wide transition-all pointer-events-none"
  >
  </div>

  <div id="monitor-view-container" class={if @live_action != :home, do: "hidden"}>
    <div class="mb-4 bg-white rounded-xl border border-zinc-200 shadow-sm p-3 flex items-center justify-end gap-2 text-xs">
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-connect-all"
          class="rounded-lg bg-blue-600 hover:bg-blue-700 px-3.5 py-1.5 text-xs font-semibold text-white transition-colors cursor-pointer shadow-sm"
        >
          全部连接
        </button>
        <button
          type="button"
          id="btn-disconnect-all"
          class="rounded-lg border border-zinc-300 bg-white hover:bg-zinc-100 px-3.5 py-1.5 text-xs font-semibold text-zinc-700 transition-colors cursor-pointer shadow-sm"
        >
          全部断开
        </button>
      </div>
    </div>

    <div
      id="stream-cards-grid"
      class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"
      data-gateway-url={@gateway_url}
    >
      <%= for {stream, idx} <- Enum.with_index(@stream_list) do %>
        <WebWeb.PlayerComponent.stream_card
          id={stream.stream_id}
          title={stream.title || "通道 #{idx + 1}: #{stream.stream_id}"}
          default_url={"#{@gateway_url}/#{stream.stream_id}"}
          zone_config={stream.zone_config}
        />
      <% end %>
    </div>
  </div>

  <div id="config-view-container" class={if @live_action != :config, do: "hidden"}>
    <div
      id="gateway-callback-config-panel"
      class="mb-5 bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden"
    >
      <div class="px-5 py-3.5 bg-zinc-50 border-b border-zinc-200">
        <h2 class="text-sm sm:text-base font-bold text-zinc-800">系统配置</h2>
      </div>

      <div class="p-5 space-y-4 text-xs">
        <div class="flex items-center gap-2">
          <label class="text-zinc-600 font-bold whitespace-nowrap">网关地址:</label>
          <input
            type="text"
            id="server-base-url"
            value={@gateway_url}
            placeholder="http://192.168.88.20:8181"
            class="w-full max-w-md rounded-md border border-zinc-300 px-3 py-1.5 text-xs font-mono text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
          />
        </div>

        <div class="flex flex-wrap items-center gap-6">
          <div class="flex items-center gap-2">
            <label class="text-zinc-600 font-bold whitespace-nowrap">回调地址:</label>
            <input
              type="text"
              id="alert-callback-url"
              value={@alert_callback_url}
              placeholder="http://192.168.88.1:4000/api/alert"
              class="w-72 sm:w-80 rounded-md border border-zinc-300 px-3 py-1.5 text-xs font-mono text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            />
          </div>

          <div class="flex items-center gap-2">
            <label class="text-zinc-600 font-bold whitespace-nowrap">最少间隔时间 (秒):</label>
            <input
              type="number"
              min="0"
              id="alert-cooldown-sec"
              value={@alert_cooldown_sec}
              class="w-24 rounded-md border border-zinc-300 px-3 py-1.5 text-xs font-mono text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            />
          </div>

          <div class="flex items-center gap-2">
            <label class="text-zinc-600 font-bold whitespace-nowrap">请求超时 (秒):</label>
            <input
              type="number"
              min="1"
              id="alert-timeout-sec"
              value={@alert_timeout_sec}
              class="w-24 rounded-md border border-zinc-300 px-3 py-1.5 text-xs font-mono text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
            />
          </div>
        </div>
      </div>
    </div>

    <div
      id="stream-config-panel"
      class="mb-5 bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden"
    >
      <div class="px-5 py-3 bg-zinc-50 border-b border-zinc-200 flex items-center justify-between">
        <h2 class="text-sm sm:text-base font-bold text-zinc-800">摄像头配置</h2>
        <button
          type="button"
          id="btn-add-stream-row"
          class="inline-flex items-center gap-1.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 text-xs font-semibold transition-all cursor-pointer shadow-xs active:scale-[0.98]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-3.5 h-3.5"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
              clip-rule="evenodd"
            />
          </svg>
          添加
        </button>
      </div>

      <div class="p-5">
        <div class="overflow-x-auto rounded-lg border border-zinc-200">
          <table class="w-full text-left text-xs text-zinc-700 border-collapse">
            <thead>
              <tr class="border-b border-zinc-200 text-zinc-600 bg-zinc-50 font-bold">
                <th class="py-2.5 px-3 w-16 text-center">序号</th>
                <th class="py-2.5 px-4 w-36">流标识</th>
                <th class="py-2.5 px-4">rtsp 流地址</th>
                <th class="py-2.5 px-4 w-32 text-center">操作</th>
              </tr>
            </thead>
            <tbody id="stream-rows-container" class="divide-y divide-zinc-100">
              <%= for {stream, idx} <- Enum.with_index(@config_stream_list) do %>
                <tr class="stream-row hover:bg-zinc-50 transition-colors">
                  <td class="py-3 px-3 text-center font-mono text-zinc-400 font-semibold row-index">
                    {idx + 1}
                  </td>
                  <td class="py-3 px-4 w-36">
                    <input
                      type="text"
                      class="input-stream-id w-28 sm:w-32 rounded-md border border-zinc-300 px-2.5 py-1.5 font-mono text-xs text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                      value={stream.stream_id}
                    />
                  </td>
                  <td class="py-3 px-4">
                    <input
                      type="text"
                      class="input-stream-url w-full rounded-md border border-zinc-300 px-3 py-1.5 font-mono text-xs text-zinc-800 bg-white shadow-inner focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                      value={stream.rtsp_url}
                    />
                  </td>
                  <td class="py-3 px-4 text-center">
                    <button
                      type="button"
                      class="btn-remove-row rounded border border-red-200 bg-red-50 text-red-600 hover:bg-red-100 hover:border-red-300 px-2.5 py-1 text-xs font-semibold cursor-pointer transition-colors shadow-2xs flex items-center justify-center gap-1 mx-auto"
                      title="删除此路直播流通道"
                    >
                      删除
                    </button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="pt-2 flex items-center justify-end">
      <button
        type="button"
        id="btn-global-save"
        class="rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2.5 text-xs sm:text-sm font-bold transition-all cursor-pointer shadow-sm hover:shadow active:scale-[0.99]"
      >
        保存
      </button>
    </div>
  </div>

  <template id="stream-card-template">
    <WebWeb.PlayerComponent.stream_card
      id="__STREAM_ID__"
      title="__STREAM_TITLE__"
      default_url="__STREAM_URL__"
    />
  </template>
</div>
