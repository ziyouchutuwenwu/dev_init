# JacWin10 for Labwc / Openbox-3
# Windows 10 style titlebar and window borders

window.title.justify: left
window.button.width: 46
window.button.height: 29
window.button.spacing: 0
window.titlebar.padding.height: 0
window.titlebar.padding.width: 0
padding.height: 0
border.width: 1

# Active window
window.active.title.bg: flat solid
window.active.title.bg.color: #FFFFFF
window.active.label.text.color: #000000
window.active.border.color: #0078D7

window.active.button.unpressed.image.color: #000000
window.button.hover.bg.color: #E5E5E5
window.button.hover.bg.corner-radius: 0

# Inactive window
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #F0F0F0
window.inactive.label.text.color: #7F7F7F
window.inactive.border.color: #CCCCCC

window.inactive.button.unpressed.image.color: #7F7F7F

# Fonts
window.active.label.text.font: shadow=n
window.inactive.label.text.font: shadow=n
